    "1. 打开「快捷指令」App，切换到「自动化」标签" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open the 'Shortcuts' app and switch to the 'Automation' tab"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 開啟「捷徑」App，切換到「自動化」標籤"
          }
        }
      }
    },
    "1. 获取快捷指令" : {
      "localizations" : {
        "en" : {
