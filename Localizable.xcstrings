    "2. 点击右上角「+」新建自动化，选择「信息」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Tap the '+' in the top right to create a new automation and select 'Message'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 點擊右上角「+」新增自動化，選擇「訊息」"
          }
        }
      }
    },
    "2. 配置与使用" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Configuration & Usage"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 設定與使用"
          }
        }
      }
    },
    "3. 在「发件人」处填入银行短信号码（如 95588）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Enter the bank's SMS number (e.g., 95588) in 'Sender'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 在「寄件人」處填入銀行簡訊號碼（如 95588）"
          }
        }
      }
    },
    "4. 勾选「立即运行」，点击「下一步」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Check 'Run Immediately' and tap 'Next'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 勾選「立即執行」，點擊「下一步」"
          }
        }
      }
    },
    "5. 添加操作：搜索 Cashback Counter，选择「解析信用卡短信」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Add Action: Search for Cashback Counter and select 'Parse Credit Card SMS'"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 加入動作：搜尋 Cashback Counter，選擇「解析信用卡簡訊」"
          }
        }
      }
    },
    "6. 点击操作卡片中的「短信全文」变量，选择上方的「快捷指令输入」>「信息」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Tap the 'SMS Text' variable in the action card, then select 'Shortcut Input' > 'Message' at the top"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 點擊動作卡片中的「簡訊全文」變數，選擇上方的「捷徑輸入」>「訊息」"
          }
        }
      }
    },
    "7. 点击「完成」保存自动化" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7. Tap 'Done' to save the automation"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7. 點擊「完成」儲存自動化"
          }
        }
      }
